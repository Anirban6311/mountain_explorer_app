OPENWEATHER_API_KEY=your_openweathermap_api_key_here
# Web OAuth 2.0 client ID (type 3) from Firebase Console > Project settings >
# Your apps > Google Sign-In. Required for Google sign-in on Android to
# produce a non-null idToken. Leave unset to disable Google sign-in.
GOOGLE_SIGN_IN_SERVER_CLIENT_ID=
# MapTiler tile provider (https://cloud.maptiler.com/account/keys/).
# Required for the offline map view (Iteration 2+). {apiKey} in the URL
# template is substituted at request time with MAPTILER_API_KEY.
MAPTILER_API_KEY=your_maptiler_api_key_here
OSM_TILE_URL_TEMPLATE=https://api.maptiler.com/maps/outdoor-v2/{z}/{x}/{y}.png?key={apiKey}
OSM_TILE_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
